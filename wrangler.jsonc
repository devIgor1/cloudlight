{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudlight",
  "account_id": "403c3c39af83ccb439cc64d95658f70b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudlight",
      "database_id": "e0245fb9-2976-4792-ab2d-1a0458b19cd1",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false },
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://cloudlight.igormraesmm.workers.dev",
    "PILOT_ENABLED": "false",
    "B2_ENDPOINT": "",
    "B2_REGION": "",
    "B2_BUCKET": "",
    "MAIL_FROM": "",
    "MAIL_FROM_NAME": "Cloudlight",
  },
}
